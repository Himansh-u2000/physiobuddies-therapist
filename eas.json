{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging-api.physiobuddies.in/api/v1",
        "EXPO_PUBLIC_USE_MOCK_API": "true",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": ""
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging-api.physiobuddies.in/api/v1",
        "EXPO_PUBLIC_USE_MOCK_API": "false",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": ""
      }
    },
    "ios-simulator": {
      "extends": "preview",
      "channel": "staging",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.physiobuddies.in/api/v1",
        "EXPO_PUBLIC_USE_MOCK_API": "false",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": ""
      }
    }
  },
  "submit": {
    "production": {}
  }
}
