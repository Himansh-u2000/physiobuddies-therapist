# Physiobuddies Therapist — LOCAL DEVELOPMENT environment
# Loaded automatically by `expo start` (NODE_ENV=development).
# EXPO_PUBLIC_* values are PUBLIC — they are compiled into the JS bundle. NEVER put secrets here.
# For EAS cloud builds the authoritative values live in eas.json > build.<profile>.env.

# Mock mode ON: the app runs fully offline against in-memory fixtures (no backend required).
EXPO_PUBLIC_USE_MOCK_API=true

# Phase 2: flip ONLY auth to the real backend while the rest of the app stays on mock.
# Set to false to exercise real email/password + Google login against the running backend.
EXPO_PUBLIC_USE_MOCK_AUTH=true

# Backend base URL (only hit when a domain's mock flag is false). Real backend base is /api/v1.
# Local backend runs at http://localhost:3000/api/v1. For a physical device over USB, run
#   adb reverse tcp:3000 tcp:3000
# so the device can reach localhost; for an Android emulator use http://10.0.2.2:3000/api/v1.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Google OAuth **Web** client ID — kept OUT of git.
# Local value lives in .env.development.local (gitignored); builds read it from an EAS env var.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
