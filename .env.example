# Physiobuddies Therapist — environment template
#
# THIS IS THE ONLY .env FILE IN GIT. `.env.development`, `.env.staging` and `.env.production`
# are git-ignored (they were untracked on 2026-08-13) — copy this file to whichever of them you
# need and fill in the values for that environment. Personal overrides go in `.env*.local`,
# which has the highest precedence and is also ignored.
#
# EXPO_PUBLIC_* values are PUBLIC — they are inlined into the JS bundle at build time and can be
# read out of any APK. NEVER put a real secret (API key, token, service-account JSON, OAuth
# client *secret*) in one. Identifiers that must not sit in git go in `.env*.local` locally and
# in the EAS project env store for cloud builds; each eas.json profile links one via
# `"environment"`.

# --- Mock switches -----------------------------------------------------------------------
# true  -> run against in-memory mock fixtures (no backend needed)
# false -> hit EXPO_PUBLIC_API_URL
EXPO_PUBLIC_USE_MOCK_API=true

# Per-domain overrides. Each falls back to EXPO_PUBLIC_USE_MOCK_API when unset, so you can turn
# domains real one at a time. Full list in src/constants/config.ts.
#   _AUTH _PROFILE _DASHBOARD _APPOINTMENTS _EARNINGS _PAYOUTS _UPLOAD
#   _AVAILABILITY _CONTENT _SESSION _TREATMENT _PATIENTS
# NOTIFICATIONS is pinned to mock regardless — those backend controllers are empty bodies that
# never respond, so a real request hangs until the client timeout.
EXPO_PUBLIC_USE_MOCK_AUTH=true

# --- Backend -----------------------------------------------------------------------------
# API base URL (backend is versioned at /api/v1).
# dev backend: https://api.dev.physiobuddies.in/api/v1
# A release build forbids cleartext HTTP, so a localhost value only works on a debug build
# (with `adb reverse tcp:3000 tcp:3000`, or 10.0.2.2 on an emulator).
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# --- Debugging ----------------------------------------------------------------------------
# In-app network log (Profile → Support → Network log): records every API request, payload and
# response so a RELEASE build can be debugged without Metro or DevTools. Defaults to __DEV__.
# `npm run apk` sets it true for review builds. Leave unset/false for store builds — it holds
# patient data in memory and the screen can share it.
EXPO_PUBLIC_ENABLE_NETWORK_LOG=
