# Physiobuddies Therapist — environment template
# Copy to `.env.local` for personal overrides (`.env*.local` is git-ignored).
# The committed `.env.development` / `.env.staging` / `.env.production` files hold the
# per-environment defaults; EAS cloud builds read from eas.json > build.<profile>.env.
#
# EXPO_PUBLIC_* values are PUBLIC — they are inlined into the JS bundle at build time.
# NEVER put secrets (API keys, tokens, service-account JSON) in an EXPO_PUBLIC_* var.

# true  -> run against in-memory mock fixtures (no backend needed)
# false -> hit EXPO_PUBLIC_API_URL
EXPO_PUBLIC_USE_MOCK_API=true

# Per-domain override for auth only (falls back to EXPO_PUBLIC_USE_MOCK_API when unset).
# false -> real email/password + Google login against the backend.
EXPO_PUBLIC_USE_MOCK_AUTH=true

# API base URL (backend is versioned at /api/v1)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Google OAuth **Web** client ID — needed for Google Sign-In (auth-code flow).
# See GOOGLE_SIGNIN_SETUP.md. Leave empty to disable the Google button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
