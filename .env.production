# Physiobuddies Therapist — PRODUCTION environment
# Mirrors the EAS "production" build profile (eas.json > build.production.env).
# EXPO_PUBLIC_* values are PUBLIC — compiled into the JS bundle. NEVER put secrets here.

# Mock mode OFF: the app talks to the production backend.
EXPO_PUBLIC_USE_MOCK_API=false

# Production API base URL. Backend is versioned at /api/v1 (auth at /api/v1/auth, etc.).
EXPO_PUBLIC_API_URL=https://api.physiobuddies.in/api/v1

# Google OAuth Web client ID (see GOOGLE_SIGNIN_SETUP.md).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
