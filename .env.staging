# Physiobuddies Therapist — STAGING environment
# Mirrors the EAS "preview" build profile (eas.json > build.preview.env).
# Load locally with NODE_ENV=staging, or install the "preview" build.
# EXPO_PUBLIC_* values are PUBLIC — compiled into the JS bundle. NEVER put secrets here.

# Mock mode OFF: the app talks to the real staging backend.
EXPO_PUBLIC_USE_MOCK_API=false

# TODO(backend): confirm the staging host below actually exists before running against it.
EXPO_PUBLIC_API_URL=https://staging-api.physiobuddies.in/api/v1

# Google OAuth Web client ID (see GOOGLE_SIGNIN_SETUP.md).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
