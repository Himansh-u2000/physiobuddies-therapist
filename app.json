{
  "expo": {
    "name": "Physiobuddies Therapist",
    "slug": "physiobuddies-therapist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "physiobuddiestherapist",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/e73e2219-8f33-41f9-8f83-ccab827af8af",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.physiobuddies.therapist",
      "infoPlist": {
        "NSCameraUsageDescription": "Physiobuddies needs camera access to capture session photos and document scans.",
        "NSLocationWhenInUseUsageDescription": "Physiobuddies uses your location to navigate to patient home visits and calculate ETA.",
        "NSFaceIDUsageDescription": "Physiobuddies uses Face ID to securely unlock the app.",
        "NSPhotoLibraryUsageDescription": "Physiobuddies needs photo library access to upload session photos and documents."
      }
    },
    "android": {
      "package": "in.physiobuddies.therapist",
      "adaptiveIcon": {
        "backgroundColor": "#003554",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#003554",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Physiobuddies to access your camera for session photos and document scans.",
          "microphonePermission": "Allow Physiobuddies to access your microphone for video calls.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Physiobuddies to access your photos so you can set a profile picture and attach credential documents.",
          "cameraPermission": "Allow Physiobuddies to use your camera to photograph credential documents and set a profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Physiobuddies to use your location for patient visit navigation."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#004060"
        }
      ],
      "expo-local-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.PLACEHOLDER-REVERSED-IOS-CLIENT-ID"
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e73e2219-8f33-41f9-8f83-ccab827af8af"
      }
    },
    "owner": "himansh-u2000"
  }
}
